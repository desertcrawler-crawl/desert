{
  "name": "desert-survival",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @desert/server --filter @desert/client dev",
    "build": "pnpm --filter @desert/client build",
    "start": "pnpm --filter @desert/server start",
    "test": "vitest run",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
